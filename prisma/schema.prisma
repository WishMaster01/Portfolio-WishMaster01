generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         String           @id @default(cuid())
  slug       String           @unique
  title      String
  category   String
  year       String
  status     String           @default("Case study")
  role       String
  timeline   String
  summary    String           @db.Text
  description String           @db.Text
  problem    String           @db.Text
  solution   String           @db.Text
  impact     String           @db.Text
  stack      String[]
  technologies String[]
  features   Json
  architecture Json
  screenshots Json
  challenges Json
  futureScope String[]
  githubUrl  String
  liveUrl    String
  milestones Json
  highlights String[]
  featured   Boolean          @default(false)
  sortOrder  Int              @default(0)
  metrics    ProjectMetric[]
  sections   ProjectSection[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  publishedAt DateTime?

  @@index([featured, sortOrder])
  @@index([category])
}

model ProjectMetric {
  id        String  @id @default(cuid())
  label     String
  value     String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId, sortOrder])
}

model ProjectSection {
  id        String  @id @default(cuid())
  title     String
  body      String  @db.Text
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId, sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  summary     String    @db.Text
  content     Json
  coverImage  String
  image       String?
  coverAlt    String
  readingTime String
  category    String
  tags        String[]
  author      String    @default("WishMaster01")
  published   Boolean   @default(true)
  publishedAt DateTime?
  date        DateTime
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, date])
  @@index([category])
  @@index([views])
}

model ResumeProfile {
  id        String   @id @default("primary")
  name      String
  title     String
  location  String
  email     String
  summary   String   @db.Text
  strengths String[]
  education Json
  resumeFile String?
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id          String                  @id @default(cuid())
  name        String
  email       String
  company     String?
  subject     String?
  message     String                  @db.Text
  source      String                  @default("portfolio")
  status      ContactSubmissionStatus @default(NEW)
  metadata    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

model NewsletterSubscription {
  id        String                     @id @default(cuid())
  email     String                     @unique
  name      String?
  source    String                     @default("portfolio")
  status    NewsletterSubscriptionStatus @default(PENDING)
  consent   Boolean                    @default(true)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([status])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model AlgorithmCategory {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String           @db.Text
  sortOrder   Int              @default(0)
  topics      AlgorithmTopic[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sortOrder])
}

model AlgorithmTopic {
  id                String              @id @default(cuid())
  slug              String              @unique
  title             String
  explanation       String              @db.Text
  visualExplanation String              @db.Text
  difficulty        String
  patterns          String[]
  recognition       String[]
  approach          String[]
  pitfalls          String[]
  timeComplexity    String
  spaceComplexity   String
  useCases          String[]
  published         Boolean             @default(true)
  sortOrder         Int                 @default(0)
  category          AlgorithmCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId        String?
  codeExamples      CodeExample[]
  problems          PracticeProblem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([published, sortOrder])
  @@index([difficulty])
  @@index([categoryId])
}

model CodeExample {
  id        String         @id @default(cuid())
  language  String         @default("Java")
  code      String         @db.Text
  isPrimary Boolean        @default(true)
  topic     AlgorithmTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([topicId, isPrimary])
}

model PracticeProblem {
  id         String         @id @default(cuid())
  title      String
  difficulty String
  pattern    String
  url        String?
  topic      AlgorithmTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([topicId])
  @@index([difficulty])
}

enum ContactSubmissionStatus {
  NEW
  REVIEWED
  RESPONDED
  ARCHIVED
}

enum NewsletterSubscriptionStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}
